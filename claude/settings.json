{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "script": "git-guard.py", "timeout": 10},
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit", "script": "write-guard.py", "timeout": 10}
    ],
    "SubagentStop": [
      {"matcher": "*", "script": "verdict-guard.py", "timeout": 5}
    ]
  },
  "defaults": {
    "attribution": {"commit": "", "pr": "", "sessionUrl": false},
    "permissions.allow": ["Bash(git commit:*)", "Bash(rm:*)", "Bash(find:*)", "Bash(mv:*)"]
  }
}

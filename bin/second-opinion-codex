#!/bin/bash
set -euo pipefail

# Each alternative opening with a negated class leans on the leading space the scan's sed prepends.
CREDENTIAL_PATTERN='[^A-Za-z0-9_]\.env|-----BEGIN|[^A-Za-z0-9]id_rsa|id_ed25519|[^A-Za-z0-9_]\.ssh/'
PERSONAL_PATTERN='[^A-Za-z0-9_](pii|gdpr|personal[-_]data|customer[-_]data|customer[-_]export|user[-_]export)([^A-Za-z0-9_]|$)'
CONFIDENTIAL_FILE=.confidential
UNAVAILABLE_PATTERN='usage limit (reached|exceeded)|hit your usage limit|quota exceeded|rate limit (reached|exceeded)|not logged in|codex login|log ?in (is )?required'

usage() {
  echo "usage: $0 diff|plan --packet FILE --out FILE" >&2
  exit 2
}

contract() {
  case "$1" in
    diff)
      cat <<'PARAGRAPH'
Review the diff below against the repository in your working directory: read any AGENTS.md or CLAUDE.md it has, and count a violation of them as a defect. Read no dotenv file, no private key and no .ssh path in that tree. Report only concrete defects, each with file and line, severity P1-P3, and the mechanism. No summary, no praise.
PARAGRAPH
      ;;
    plan)
      cat <<'PARAGRAPH'
Challenge the plan below. Report only REFUTE (a premise that is false), MISSING (a constraint not considered) and ALTERNATIVE (a cheaper approach) items, each with the evidence for it. No score, no summary, no praise.
PARAGRAPH
      ;;
  esac
  echo
}

scan() {
  local pattern="$1"
  shift
  LC_ALL=C sed 's/\.env\.example//g; s/^/ /' "$packet" | LC_ALL=C grep -n -o -E "$@" -e "$pattern" | head -n 1 || true
}

refuse() {
  local class="$1" hit="$2" match
  match="${hit#*:}"
  echo "second-opinion-codex refused: packet line ${hit%%:*} names $class: ${match# }" >&2
  exit 2
}

glob_to_ere() { printf '%s' "$1" | LC_ALL=C sed -e 's/[][\.^$+(){}|]/\\&/g' -e 's/\*/[^ ]*/g' -e 's/?/./g'; }

confidential_pattern() {
  local root file line pattern=""
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  file="$root/$CONFIDENTIAL_FILE"
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in ''|'#'*) continue ;; esac
    pattern="${pattern:+$pattern|}$(glob_to_ere "$line")"
  done < "$file"
  printf '%s' "$pattern"
}

mode="${1:-}"
case "$mode" in
  diff|plan) shift ;;
  *) usage ;;
esac

packet=""
out=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --packet) [ "$#" -ge 2 ] || usage; packet="$2"; shift 2 ;;
    --out) [ "$#" -ge 2 ] || usage; out="$2"; shift 2 ;;
    *) usage ;;
  esac
done
{ [ -n "$packet" ] && [ -n "$out" ]; } || usage
[ -f "$packet" ] || usage

hit="$(scan "$CREDENTIAL_PATTERN")"
if [ -n "$hit" ]; then refuse "a credential path" "$hit"; fi
hit="$(scan "$PERSONAL_PATTERN" -i)"
if [ -n "$hit" ]; then refuse "personal data" "$hit"; fi
marked="$(confidential_pattern)"
if [ -n "$marked" ]; then
  hit="$(scan "$marked")"
  if [ -n "$hit" ]; then refuse "a path $CONFIDENTIAL_FILE marks" "$hit"; fi
fi

if ! ( : >>"$out" ) 2>/dev/null; then
  echo "second-opinion-codex: cannot write $out" >&2
  exit 2
fi

assembled="$(mktemp "${TMPDIR:-/tmp}/second-opinion-codex.XXXXXX")" \
  || { rm -f "$out"; echo "second-opinion-codex: cannot create a temp file" >&2; exit 2; }
trap 'rm -f "$assembled"' EXIT
{ contract "$mode"; cat "$packet"; } > "$assembled"

status=0
CODEX_CA_CERTIFICATE=/etc/ssl/cert.pem codex exec -s read-only --ignore-user-config - \
  <"$assembled" >"$out" 2>"$out.stderr" || status=$?

if [ "$status" != 0 ] || [ ! -s "$out" ]; then
  reason="$(grep -i -E "$UNAVAILABLE_PATTERN" "$out.stderr" 2>/dev/null | sed -n '/./{p;q;}' || true)"
  [ -n "$reason" ] || reason="$(sed -n '/./{p;q;}' "$out.stderr" 2>/dev/null || true)"
  rm -f "$out"
  echo "second-opinion-codex unavailable: ${reason:-no output from codex}" >&2
  exit 1
fi
